# Environment Configuration Guide
# Copy this to .env and fill in your values

# Flask Configuration
APP_ENV=development
# Options: development, production, testing
# IMPORTANT: Set to 'production' in production!

# Secret Key (GENERATE A STRONG KEY!)
# In production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# SQLite (default for development):
#DATABASE_URL=sqlite:///instance/farm_data.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/farm_db

# Farm Location
FARM_LATITUDE=26.1445
FARM_LONGITUDE=91.7362

# AI Service (Gemini API for disease diagnosis)
GEMINI_API_KEY=your-gemini-api-key-here

# Weather API (optional, uses free Open-Meteo by default)
# OPENWEATHERMAP_API_KEY=your-openweathermap-key-here

# Logging
LOG_LEVEL=INFO
